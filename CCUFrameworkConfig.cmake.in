# CCUFrameworkConfig.cmake.in - relocatable CMake package config (CR-006 §5)
#
# Generated by configure_package_config_file(). The @PACKAGE_INIT@ block derives
# PACKAGE_PREFIX_DIR from this file's own location, so the same install tree is
# consumable from any staging prefix (local ~/.local, /opt/ccu, BUILD DESTDIR)
# without baking an absolute host/personal path.
#
# Standard entry:
#   find_package(CCUFramework CONFIG REQUIRED)
#   target_link_libraries(consumer PRIVATE CCUFramework::ccu-framework-config)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Threads is a PUBLIC link dependency of ccu-framework-log/store/someip (the
# async queue / key locks / worker pool use std::thread). Resolve it first.
find_dependency(Threads REQUIRED)

# yaml-cpp is a PRIVATE link dependency of the static ccu-framework-config and
# ccu-framework-log archives. Static archives do not resolve their own
# dependencies, so the final link of any consumer requires yaml-cpp to be
# resolvable from a controlled dependency prefix (CR-006 §6/§7). This must not
# be deleted to mask a missing dependency; if the export interface is ever
# proven not to reference yaml-cpp, adjust via a new CR.
find_dependency(yaml-cpp CONFIG REQUIRED)

# vsomeip is a PUBLIC link dependency of ccu-framework-someip only when the
# platform build enabled the production backend (CR-005 §15). The exported
# target then references PkgConfig::VSOMEIP, so that imported target must be
# recreated in the consumer's scope before the targets file is included.
# CCU_FW_SOMEIP_VSOMEIP is baked in at configure time by the framework build.
set(CCUFramework_WITH_VSOMEIP @CCU_FW_SOMEIP_VSOMEIP@)
if(CCUFramework_WITH_VSOMEIP)
    find_dependency(PkgConfig REQUIRED)
    if(NOT TARGET PkgConfig::VSOMEIP)
        pkg_check_modules(VSOMEIP REQUIRED IMPORTED_TARGET vsomeip3)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CCUFrameworkTargets.cmake")

check_required_components(CCUFramework)
