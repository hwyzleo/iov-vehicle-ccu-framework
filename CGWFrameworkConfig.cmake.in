# CGWFrameworkConfig.cmake.in - relocatable CMake package config (CR-006 §5)
#
# Generated by configure_package_config_file(). The @PACKAGE_INIT@ block derives
# PACKAGE_PREFIX_DIR from this file's own location, so the same install tree is
# consumable from any staging prefix (local ~/.local, /opt/cgw, BUILD DESTDIR)
# without baking an absolute host/personal path.
#
# Standard entry:
#   find_package(CGWFramework CONFIG REQUIRED)
#   target_link_libraries(consumer PRIVATE CGWFramework::cgw-framework-config)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Threads is a PUBLIC link dependency of cgw-framework-log/store/someip (the
# async queue / key locks / worker pool use std::thread). Resolve it first.
find_dependency(Threads REQUIRED)

# yaml-cpp is a PRIVATE link dependency of the static cgw-framework-config and
# cgw-framework-log archives. Static archives do not resolve their own
# dependencies, so the final link of any consumer requires yaml-cpp to be
# resolvable from a controlled dependency prefix (CR-006 §6/§7). This must not
# be deleted to mask a missing dependency; if the export interface is ever
# proven not to reference yaml-cpp, adjust via a new CR.
find_dependency(yaml-cpp CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/CGWFrameworkTargets.cmake")

check_required_components(CGWFramework)
