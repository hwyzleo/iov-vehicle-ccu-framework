include(CMakeFindDependencyMacro)

# 版本检查
include(CMakePackageConfigHelpers)

# yaml-cpp 是 cgw-framework 的链接依赖（静态链接但符号需传递给调用方）
find_dependency(yaml-cpp)

# 定义库相关的变量
set(CGW_FRAMEWORK_LIBRARIES CGWFramework::cgw-framework yaml-cpp::yaml-cpp)
set(CGW_FRAMEWORK_INCLUDE_DIRS "@CMAKE_INSTALL_PREFIX@/include")

# 包含目标文件
include("${CMAKE_CURRENT_LIST_DIR}/CGWFrameworkTargets.cmake")
